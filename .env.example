# Optional Docker Compose overrides. Copy to .env and adjust as needed.
# Do not commit .env or any secret files.

# Image tag to run (published by GitHub Actions to GHCR)
# DMD_IMAGE=ghcr.io/lostinfuture/dreame-dashboard:latest

# Host UID/GID owning ./data (and optional ./secrets)
# DMD_UID=1000
# DMD_GID=1000

# Container timezone for timestamps and chart labels
# TZ=UTC

# Dreame cloud region: us, eu, cn, sg, kr, ru
# DMD_REGION=us

# Polling interval (20s to 300s)
# DMD_POLL_INTERVAL=30s

# Set true to lock out all device controls (overrides the web UI switch)
# DMD_READ_ONLY=false

# Set true to subscribe to Dreame MQTT push updates alongside HTTP polling
# DMD_ENABLE_MQTT=false
